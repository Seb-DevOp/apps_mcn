# --- MCN THE VAULT ---
# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Locally the simplest option is a Neon development branch:
# neon.tech -> your project -> Branches -> New branch -> copy both strings.
#   DATABASE_URL          pooled   (host contains "-pooler")  — used by the app
#   DATABASE_URL_UNPOOLED direct   (no "-pooler")             — used by migrations
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Signs the session cookie. Must be a strong random value in production —
# the server refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-a-long-random-value-at-least-16-chars"

# Populate the leaderboard with 12 demo Guardians. Leave unset in production.
SEED_DEMO="true"

# --- Feature flags (V1 keeps Web3 prepared but OFF) ---
NEXT_PUBLIC_WALLET_ENABLED="false"
MCN_TOKEN_REWARDS_ENABLED="false"
NEXT_PUBLIC_MCN_CHAIN="base"
MCN_TOKEN_ADDRESS=""

# --- Accounts (optional) ---
# Passkeys are bound to a domain. Set this in production so the relying-party ID
# never comes from a request header alone.
APP_ORIGIN=""

# Email delivery. Without both of these, confirmation and reset links are not sent
# and the interface says so. Passkeys and recovery codes are unaffected.
RESEND_API_KEY=""
EMAIL_FROM=""

# External identities, switched on in V3.
FARCASTER_AUTH_ENABLED="false"

# --- Retention ---
# Set this on Vercel and the nightly purge cron can call /api/cron/purge.
# Without it the route refuses every request, including Vercel own.
#
# ASCII ONLY. Vercel sends this value as an HTTP header, and a single accented
# character makes every deployment fail at build time with a message that does
# not obviously point at this file. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
