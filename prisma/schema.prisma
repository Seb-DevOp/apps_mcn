// MCN — THE VAULT · V1 data model
// Written to stay portable: no native enums, no Json columns, no arrays.
//
// Neon (and every serverless Postgres) needs two connections: a pooled one for the
// running app, and a direct one for migrations, which cannot run through a pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// PLAYERS
// ---------------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  handle     String   @unique // public name inside the Kingdom
  locale     String   @default("en") // "en" | "fr"
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Progression (server-authoritative — never written from the client)
  xp      Int    @default(0)
  shards  Int    @default(0)
  rankKey String @default("wanderer")

  // Streak
  currentStreak   Int     @default(0)
  bestStreak      Int     @default(0)
  totalActiveDays Int     @default(0)
  lastActiveDay   String? // "YYYY-MM-DD" in the player local day
  streakShields   Int     @default(1) // forgiving streak: absorbs one missed day
  lastChestDay    String?

  // --- Identity -------------------------------------------------------
  // A guest account has none of these. Claiming one is what makes progress
  // survive a lost phone, a cleared browser or a new device.
  email           String?   @unique
  emailVerifiedAt DateTime?
  passwordHash    String? // scrypt, salted, encoded in the value itself
  claimedAt       DateTime? // the moment the account stopped being anonymous

  // Web3 (prepared, inert while MCN_TOKEN_REWARDS_ENABLED=false)
  walletAddress  String?
  walletChain    String?
  walletLinkedAt DateTime?

  isAdmin Boolean @default(false)

  sessions      Session[]
  inventory     InventoryItem[]
  chestOpenings ChestOpening[]
  missions      UserMission[]
  gameSessions  GameSession[]
  scores        ScoreEntry[]
  xpLedger      XpLedger[]
  events        AnalyticsEvent[]
  activity      DailyActivity[]
  boosts        UserBoost[]
  grants        RewardGrant[]
  equipment     UserEquipment[]
  idle          IdleProfile?
  idleItems     IdleItem[]
  credentials   Credential[]
  recoveryCodes RecoveryCode[]
  emailTokens   EmailToken[]
  identities    LinkedIdentity[]

  @@index([xp])
  @@index([currentStreak])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// IDLE PROGRESSION
// ---------------------------------------------------------------------------

/// One row per player. Nothing ticks on a timer: progress is computed from
/// lastTickAt whenever the state is read, which is what makes offline progress
/// fall out for free and keeps the clock on the server.
model IdleProfile {
  userId String @id

  /// Global level, never reset. Floor and boss position are derived from it.
  level        Int   @default(1)
  highestLevel Int   @default(1)
  /// Health left on the enemy currently being fought.
  enemyHp      Float @default(0)
  /// Whether that enemy came back wrong. Rolled when it spawns, not when it is read.
  enemyElite   Boolean @default(false)
  /// Health left on the cat. Zero means "never fought yet" and is read as full,
  /// which is also how rows written before combat existed are carried over.
  hp           Float @default(0)
  /// Seconds still owed to picking itself up after a defeat.
  recoverFor   Float @default(0)
  defeats      Int   @default(0)

  /// Doubles rather than integers: idle currencies outgrow a 32-bit column
  /// within hours, and 15 significant digits is far more than this needs.
  gold      Float @default(0)
  totalGold Float @default(0)

  kills     Int @default(0)
  bossKills Int @default(0)
  /// Chambers cleared across every life. Survives a rebirth on purpose: it is the
  /// only number that says how much Vault a cat has actually walked, where the
  /// record only says how far down it once got.
  totalLevels Int @default(0)

  /// { attack: 3, health: 1, ... } — keys come from UPGRADES in content/idle.
  /// Reset by a rebirth: gold has to have something to buy again.
  upgradesJson String @default("{}")

  /// --- Rebirth: what survives a life ---------------------------------
  /// Unspent relics, and the total ever granted. The total is what stops
  /// rebirthing at the shallowest allowed floor from being a farm: relics are
  /// owed on record depth, so only going deeper than ever before pays.
  /// Floats, like gold: relics are exponential in the record floor and pass a
  /// 32-bit integer somewhere around floor sixty-four, which is reachable.
  relics        Float  @default(0)
  relicsEarned  Float  @default(0)
  rebirths      Int    @default(0)
  /// { memory: 4, tenacity: 2, ... } — permanent, never reset.
  relicsJson    String @default("{}")

  /// --- The two things a player does with their hands ------------------
  /// Both clamped server-side: taps by elapsed time, the Roar by its cooldown.
  lastStrikeAt DateTime @default(now())
  lastRoarAt   DateTime @default(now())
  lastBreathAt DateTime @default(now())
  /// Seconds of immunity still owed to the cat, carried between ticks.
  shieldFor    Float    @default(0)

  /// --- The shop ------------------------------------------------------
  /// Gems. Earned from Guardians, one floor at a time, so they accumulate
  /// linearly where gold is exponential — which is what lets a shop price mean
  /// the same thing at every depth. They survive a rebirth.
  gems      Int @default(0)
  gemsEarned Int @default(0)

  /// Chests bought. Only its remainder matters: every tenth one is guaranteed.
  chestsOpened Int    @default(0)
  /// The coat currently worn, and every coat ever bought. Cosmetics survive a
  /// rebirth — making a player buy the same colour twice is not a gold sink.
  skinKey      String @default("classic")
  skinsJson    String @default("[]")
  /// The coats the Pack and the Pride wear, in order. Empty entries fall back
  /// to the first cat's, so three cats look like one family until told
  /// otherwise. ["ember", "shadow"] dresses the second and third.
  catSkinsJson String @default("[]")

  /// The profile backdrop worn, and every one ever bought. Cosmetic, so both
  /// survive a rebirth: making a player buy the same wall twice is not a sink.
  backdropKey   String @default("")
  backdropsJson String @default("[]")

  /// --- The calendar --------------------------------------------------
  /// Which of the thirty doors is next, and how many calendars have been
  /// finished. Nothing here is a date: a missed day costs the day, never the
  /// progress, so the state is a count and not a grid.
  calendarDay   Int    @default(1)
  calendarCycle Int    @default(0)
  /// The UTC day the last door was opened, so a second opening has to wait for
  /// tomorrow. UTC on purpose — a device clock is a lever anyone can pull.
  calendarDayKey String @default("")

  /// --- Boosts --------------------------------------------------------
  /// { gold: 2, damage: 1 } — how many of each are held, unspent.
  boostsJson String @default("{}")
  /// The one currently running, and when it stops. One at a time: two
  /// multipliers on the same number is a stack nobody can read.
  boostKey   String   @default("")
  boostUntil DateTime @default(now())

  /// --- The Nose ------------------------------------------------------
  /// Rarity below which a find sells itself. Empty means keep everything.
  autoSellBelow String @default("")

  lastTickAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A looted piece. Generated from (slot, floor, rarity) rather than a catalogue,
/// because an idle game has no last floor for a catalogue to cover.
model IdleItem {
  id     String @id @default(cuid())
  userId String

  slot   String
  floor  Int
  rarity String
  shape  String

  power     Float
  vitality  Float @default(0)
  goldBonus Float @default(0)

  /// [{ "key": "attack", "value": 0.12 }] — bonuses to the six bought statistics.
  /// A string rather than a Json column, like upgradesJson: the schema stays
  /// portable to any Prisma provider, which was the point of avoiding them.
  affixesJson String @default("[]")

  /// Null when owned but not worn; "HEAD" for the cat, "PACK:HEAD" for the
  /// second one. Postgres treats NULLs as distinct, so the unique index below
  /// allows any number of spares and exactly one worn piece per slot per cat —
  /// the prefix means one constraint covers both, with nothing to keep in step.
  equippedSlot String?

  foundAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, equippedSlot])
  @@index([userId, slot])
}

// ---------------------------------------------------------------------------
// AUTHENTICATION
// ---------------------------------------------------------------------------

/// A WebAuthn passkey. The private half never leaves the player's device.
model Credential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String    @default("")
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived WebAuthn challenge. Stored server-side so a replayed one is refused.
model AuthChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String   @unique
  kind      String // REGISTER | AUTHENTICATE
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One-time account recovery code. Only the hash is ever stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification and password reset. Only the hash is stored, never the token.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  kind      String // VERIFY | RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// External identities. Farcaster and wallet plug in here in V3 — the table and
/// the service exist now so nothing has to be migrated when they are switched on.
model LinkedIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String // FARCASTER | WALLET
  externalId String
  metaJson   String   @default("{}")
  linkedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CONFIGURATION (seeded — the V2 admin panel edits these rows, not the code)
// ---------------------------------------------------------------------------

model RankConfig {
  key          String @id // wanderer | guardian | royal-guardian | elite-guardian | vault-keeper | legend
  order        Int    @unique
  emoji        String
  nameEn       String
  nameFr       String
  minXp        Int
  artPath      String
  accentColor  String
  taglineEn    String
  taglineFr    String
  chestTypeKey String
}

model ChestType {
  key      String            @id
  rankKey  String            @unique
  tier     Int
  nameEn   String
  nameFr   String
  descEn   String
  descFr   String
  entries  RewardPoolEntry[]
  openings ChestOpening[]
}

model RewardPoolEntry {
  id           String    @id @default(cuid())
  chestTypeKey String
  chestType    ChestType @relation(fields: [chestTypeKey], references: [key], onDelete: Cascade)

  rewardType String // XP | SHARD | ITEM | BOOST | COSMETIC | BADGE
  itemKey    String? // FK-by-key into ItemDef when rewardType is ITEM/BOOST/COSMETIC/BADGE
  minQty     Int     @default(1)
  maxQty     Int     @default(1)
  weight     Int     @default(100) // relative weight — exposed to players for transparency
  rarity     String  @default("COMMON") // COMMON | UNCOMMON | RARE | EPIC | MYTHIC | LEGENDARY
  guaranteed Boolean @default(false) // rolled on every open, outside the weighted draw

  @@index([chestTypeKey])
}

model ItemDef {
  key       String  @id
  type      String // MATERIAL | FRAGMENT | COSMETIC | BOOST | BADGE | EQUIPMENT | KEY
  rarity    String  @default("COMMON")
  nameEn    String
  nameFr    String
  descEn    String  @default("")
  descFr    String  @default("")
  icon      String  @default("crystal")
  stackable Boolean @default(true)
  // Free-form JSON string: boost multipliers, future equipment stats, future NFT metadata.
  metaJson  String  @default("{}")

  inventory InventoryItem[]
}

model MissionDef {
  key          String  @id
  scope        String // DAILY | WEEKLY
  goalType     String // OPEN_CHEST | PLAY_GAME | EARN_XP | GAME_SCORE | COLLECT_SHARDS | KEEP_STREAK | VISIT_VAULT | COLLECT_ITEMS
  goalTarget   Int
  nameEn       String
  nameFr       String
  rewardsJson  String  @default("[]") // [{type,itemKey,qty}]
  minRankOrder Int     @default(0)
  weight       Int     @default(100)
  active       Boolean @default(true)
}

// ---------------------------------------------------------------------------
// EQUIPMENT (V2)
// ---------------------------------------------------------------------------

model EquipmentDef {
  key               String  @id
  slot              String // WEAPON | ARMOR | RELIC | CLOAK | ACCESSORY
  weaponClass       String? // SCEPTER | BOW | SWORD | MAGIC_SWORD
  rarity            String
  nameEn            String
  nameFr            String
  descEn            String
  descFr            String
  icon              String
  // Level-1 statistics; the level curve lives in code and is applied on read.
  baseStatsJson     String
  maxLevel          Int     @default(5)
  shardPrice        Int
  requiredRankOrder Int     @default(0)
  abilityKey        String?

  owned UserEquipment[]
}

model UserEquipment {
  id           String   @id @default(cuid())
  userId       String
  defKey       String
  level        Int      @default(1)
  // null means owned but not worn. Postgres treats NULLs as distinct, so the
  // unique index below allows many unequipped items and exactly one per slot.
  equippedSlot String?
  acquiredAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  def  EquipmentDef @relation(fields: [defKey], references: [key], onDelete: Cascade)

  @@unique([userId, defKey])
  @@unique([userId, equippedSlot])
  @@index([userId])
}

model AppConfig {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// PLAYER STATE
// ---------------------------------------------------------------------------

model InventoryItem {
  id       String   @id @default(cuid())
  userId   String
  itemKey  String
  quantity Int      @default(0)
  firstAt  DateTime @default(now())
  lastAt   DateTime @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ItemDef @relation(fields: [itemKey], references: [key], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

model UserBoost {
  id         String   @id @default(cuid())
  userId     String
  boostKey   String
  statKey    String // XP | SHARD | SCORE
  multiplier Float    @default(1.25)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ChestOpening {
  id           String   @id @default(cuid())
  userId       String
  chestTypeKey String
  day          String // "YYYY-MM-DD" — one free chest per local day
  streakDay    Int      @default(1) // 1..7 position in the streak cycle
  rewardsJson  String
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chestType ChestType @relation(fields: [chestTypeKey], references: [key])

  @@unique([userId, day]) // hard server-side guarantee: one daily chest, no double claim
  @@index([userId])
}

model UserMission {
  id          String    @id @default(cuid())
  userId      String
  missionKey  String
  scope       String // DAILY | WEEKLY
  periodKey   String // "2026-08-20" or "2026-W34"
  progress    Int       @default(0)
  target      Int
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, periodKey])
  @@index([userId, scope, periodKey])
}

// ---------------------------------------------------------------------------
// MINI-GAME (server-authoritative: the server owns the seed AND the scoring)
// ---------------------------------------------------------------------------

model GameSession {
  id      String @id @default(cuid())
  userId  String
  gameKey String @default("crystal-resonance")
  seed    String // drives the spawn pattern; the client only renders it
  targets Int
  status  String @default("OPEN") // OPEN | SCORED | REJECTED | EXPIRED

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  score            Int     @default(0)
  accuracy         Float   @default(0)
  bestCombo        Int     @default(0)
  xpAwarded        Int     @default(0)
  shardsAwarded    Int     @default(0)
  clientDurationMs Int     @default(0)
  invalidReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ScoreEntry {
  id        String   @id @default(cuid())
  userId    String
  gameKey   String
  score     Int
  weekKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameKey, score])
  @@index([weekKey, score])
}

// ---------------------------------------------------------------------------
// AUDIT / ANALYTICS / FUTURE REWARDS
// ---------------------------------------------------------------------------

model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  source    String // CHEST | GAME | MISSION | STREAK | RANKUP | ADMIN
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DailyActivity {
  id              String  @id @default(cuid())
  userId          String
  day             String
  gamesPlayed     Int     @default(0)
  xpEarned        Int     @default(0)
  chestOpened     Boolean @default(false)
  missionsClaimed Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  propsJson String   @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
}

// Prepared for V3/V4. Nothing writes MCN rows while the feature flag is off.
model RewardGrant {
  id         String   @id @default(cuid())
  userId     String
  rewardType String // XP | ITEM | COSMETIC | BADGE | VAULT_SHARD | MCN
  itemKey    String?
  amount     String   @default("0") // string-encoded to stay safe for token decimals
  status     String   @default("PENDING") // PENDING | APPROVED | CLAIMED | FAILED | DISABLED
  txHash     String?
  chain      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
